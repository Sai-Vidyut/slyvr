AZURE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=

# Object storage write provider: azure | b2 (default: azure when AZURE_CONNECTION_STRING is set)
# SLYVR_STORAGE_PROVIDER=azure

# Backblaze B2 (S3-compatible API) — application key only; keep buckets private
B2_ENDPOINT=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
# Optional: separate application keys when buckets use different B2 app keys
B2_THUMBNAIL_ACCESS_KEY_ID=
B2_THUMBNAIL_SECRET_ACCESS_KEY=
B2_BUCKET_NAME=
B2_THUMBNAIL_BUCKET_NAME=

# Supabase Auth (identity only — media DB stays local SQLite)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Optional: pepper for hashing workspace join codes (defaults to JWT secret)
SLYVR_JOIN_CODE_PEPPER=

# Comma-separated browser origins allowed by CORS (no *)
# Production Slyvr UI Origin is https://buildwsai.online (path /slyvr is not part of Origin)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://buildwsai.online,https://buildwsai.com,https://www.buildwsai.com

# Max upload size in bytes (default 2 GiB if unset)
# SLYVR_MAX_UPLOAD_BYTES=

# Local/dev only: allow access to the isolated legacy library (existing clips)
SLYVR_LEGACY_LIBRARY_ACCESS=0

# Signed media read URLs (Phase 3). Deploy with frontend VITE_SIGNED_MEDIA_READS=1 so the UI
# calls GET /clips/{id}/read-url. This flag does not remove blob_url/thumbnail_url from API responses.
SLYVR_SIGNED_MEDIA_READS=0
# Omit raw blob URLs from clip/upload API responses — only after frontend uses read-url.
SLYVR_HIDE_DIRECT_MEDIA_URLS=0
# SAS lifetime in seconds (default 3600, min 300, max 86400)
# SLYVR_MEDIA_READ_SAS_TTL_SECONDS=3600

# Test helpers (never enable in production)
SLYVR_AUTH_TEST_MODE=0
SLYVR_JWT_SECRET=
