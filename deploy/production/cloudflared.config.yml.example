# Copy to /etc/cloudflared/config.yml on the API host (never commit real credentials).
# Replace <TUNNEL_UUID> with output of: sudo cloudflared tunnel list

tunnel: <TUNNEL_UUID>
credentials-file: /etc/cloudflared/<TUNNEL_UUID>.json

ingress:
  - hostname: api.buildwsai.online
    service: http://127.0.0.1:8000
  - service: http_status:404
