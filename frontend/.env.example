# API base URL. Leave empty in dev to use Vite proxy (/api → localhost:8000).
VITE_API_URL=

# Supabase Auth (public client config only — never put the service role key here)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Enable with backend SLYVR_SIGNED_MEDIA_READS=1 (coordinated deploy). Optional stricter API:
# backend SLYVR_HIDE_DIRECT_MEDIA_URLS=1 after this is live.
VITE_SIGNED_MEDIA_READS=0
